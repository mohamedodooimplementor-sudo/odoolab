<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.home_screen_designer</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Home Screen" string="Home Screen" name="home_screen_designer"
                     groups="base.group_system">
                    <block title="Personalization" name="hsd_access">
                        <setting string="Users can personalize their home screen"
                                 help="Off: only the administrators open the Home Screen Designer, and every user gets the company layout (saved by an administrator in the designer, More options > Save as the company layout). On: the users can also save a personal layout; hide the designer for some of them in their user form (Preferences tab).">
                            <field name="hsd_users_can_customize"/>
                        </setting>
                    </block>
                    <block title="Theme Colors" name="hsd_colors">
                        <setting string="Main Colors"
                                 help="Colors of the whole interface, compiled into Odoo's styles. Leave empty to keep Odoo's color. The page reloads after saving.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="hsd_color_brand" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_color_brand" widget="color" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="hsd_color_primary" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_color_primary" widget="color" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="hsd_color_navbar" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_color_navbar" widget="color" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Status Colors"
                                 help="Colors of the success, information, warning and danger messages, badges and buttons.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="hsd_color_success" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_color_success" widget="color" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="hsd_color_info" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_color_info" widget="color" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="hsd_color_warning" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_color_warning" widget="color" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="hsd_color_danger" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_color_danger" widget="color" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Dark Mode Colors"
                                 help="Optional colors used in dark mode only. Empty: the main colors are used.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="hsd_color_brand_dark" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_color_brand_dark" widget="color" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="hsd_color_primary_dark" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_color_primary_dark" widget="color" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="hsd_color_navbar_dark" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_color_navbar_dark" widget="color" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Odoo Colors" help="Forget every custom color and go back to Odoo's palette.">
                            <button name="action_hsd_reset_colors" type="object" string="Reset the Colors"
                                    icon="oi-arrow-right" class="btn-link"
                                    confirm="Go back to Odoo's colors? The page will reload."/>
                        </setting>
                    </block>
                    <block title="Installable App" name="hsd_pwa">
                        <setting string="App Icon"
                                 help="Icon of Odoo once installed on a phone or a computer (Android, iOS, Chrome, Edge). Square picture, at least 512 x 512 px. Devices that already installed the app keep the old icon until it is installed again.">
                            <field name="hsd_pwa_icon" widget="image" class="w-auto"
                                   options="{'size': [96, 96]}"/>
                        </setting>
                        <setting string="App Colors"
                                 help="Color of the window title bar and of the splash screen of the installed app.">
                            <div class="content-group">
                                <div class="row mt-2">
                                    <label for="hsd_pwa_theme_color" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_pwa_theme_color" widget="color" class="col-lg-3"/>
                                </div>
                                <div class="row">
                                    <label for="hsd_pwa_background_color" class="col-lg-5 o_light_label"/>
                                    <field name="hsd_pwa_background_color" widget="color" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_hsd_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.res_config_settings_view_form"/>
        <field name="context">{'module': 'home_screen_designer'}</field>
    </record>
</odoo>
