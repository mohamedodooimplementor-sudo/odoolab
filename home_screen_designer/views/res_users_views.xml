<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Administrators choose who can personalize their home screen. -->
    <record id="view_users_form_hsd" model="ir.ui.view">
        <field name="name">res.users.form.home_screen_designer</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']//group[@name='other_preferences']" position="inside">
                <field name="hsd_show_designer"/>
            </xpath>
        </field>
    </record>
</odoo>
